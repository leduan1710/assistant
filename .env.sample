GEMINI_API_KEY=

# Optional: reuse the same File Search store across daily runs instead of
# creating a new one each time. Leave blank on the very first run — the
# job will create one and print its name for you to copy here.
FILE_SEARCH_STORE_NAME=

# Optional overrides
MARKDOWN_OUTPUT_DIR=./articles
MIN_ARTICLES=30
# The site has 400+ articles; this caps how many are scraped/uploaded so
MAX_ARTICLES=40
